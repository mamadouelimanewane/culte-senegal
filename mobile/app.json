{
  "expo": {
    "name": "SCeNews",
    "slug": "scenews-client",
    "version": "1.0.0",
    "sdkVersion": "55.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a3d6b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mamadouelimane.scenews",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Scenews utilise votre position pour afficher les lieux culturels proches de vous.",
        "NSMicrophoneUsageDescription": "Scenews utilise le micro pour la recherche vocale.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.mamadouelimane.scenews",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "c401c7c4-1ae4-41be-84d8-7a9ca0078617"
      }
    }
  }
}
