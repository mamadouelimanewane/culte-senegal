{
  "expo": {
    "name": "SCeNews",
    "slug": "ndugumi-user",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a3d6b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mamadouelimane.scenews",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "SCeNews utilise le microphone lorsque vous lancez une recherche vocale de lieux culturels.",
        "NSSpeechRecognitionUsageDescription": "SCeNews transcrit votre recherche vocale pour trouver des lieux culturels."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.mamadouelimane.scenews",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "2c813298-042b-4c16-b139-a82c0790dc50"
      }
    },
    "owner": "mamadouelimane"
  }
}
