# ════════════════════════════════════════════════════════════════
#  Variables d'environnement — à définir dans Vercel
#  (Project Settings → Environment Variables), jamais dans le dépôt.
# ════════════════════════════════════════════════════════════════

# Chaîne de connexion Postgres (Neon : utiliser l'URL "pooled").
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Secret de signature des JWT — 32 caractères minimum.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Optionnel : mot de passe imposé lors de db/create-admin.js
# (sinon un mot de passe aléatoire est généré et affiché une fois).
# ADMIN_PASSWORD=

# Optionnel : désactive TLS pour un Postgres local de développement.
# PGSSL_DISABLE=1
